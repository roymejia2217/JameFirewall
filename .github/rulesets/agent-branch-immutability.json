{
  "name": "agent-branch-immutability",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": [
        "~ALL"
      ],
      "exclude": [
        "~DEFAULT_BRANCH",
        "refs/heads/release-please--branches--main--components--JameFirewall"
      ]
    }
  },
  "rules": [
    {
      "type": "non_fast_forward"
    }
  ]
}
